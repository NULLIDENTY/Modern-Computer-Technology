import { useState } from 'react';
import { Link, useLocation } from 'wouter';
import { trpc } from '@/lib/trpc';
import { Loader2, ChevronLeft, ChevronRight, Search } from 'lucide-react';

export default function BlogListPage() {
  const [location] = useLocation();
  const [offset, setOffset] = useState(0);
  const [searchQuery, setSearchQuery] = useState('');
  const [searching, setSearching] = useState(false);

  const limit = 10;
  const postsQuery = trpc.blog.listPosts.useQuery({ limit, offset });
  const searchQuery_trpc = trpc.blog.search.useQuery(
    { query: searchQuery, limit: 50, offset: 0 },
    { enabled: searching && searchQuery.length > 0 }
  );

  const posts = searching ? searchQuery_trpc.data : postsQuery.data;
  const isLoading = searching ? searchQuery_trpc.isLoading : postsQuery.isLoading;

  const handleSearch = (e: React.FormEvent) => {
    e.preventDefault();
    setSearching(true);
    setOffset(0);
  };

  const handleClearSearch = () => {
    setSearching(false);
    setSearchQuery('');
    setOffset(0);
  };

  return (
    <div className="min-h-screen bg-background text-foreground">
      {/* Header */}
      <section className="border-b border-border py-12 md:py-16">
        <div className="container-responsive">
          <h1 className="text-4xl md:text-5xl font-bold mb-4 neon-glow">
            Blog Posts
          </h1>
          <p className="text-lg text-muted-foreground">
            Security research, bug bounties, and technology insights
          </p>
        </div>
      </section>

      {/* Search Bar */}
      <section className="border-b border-border py-8">
        <div className="container-responsive">
          <form onSubmit={handleSearch} className="flex gap-2">
            <div className="flex-1 relative">
              <input
                type="text"
                placeholder="Search posts by title, content, or tags..."
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                className="input w-full"
              />
            </div>
            <button type="submit" className="button button-primary inline-flex items-center gap-2">
              <Search className="w-4 h-4" />
              Search
            </button>
            {searching && (
              <button
                type="button"
                onClick={handleClearSearch}
                className="button button-outline"
              >
                Clear
              </button>
            )}
          </form>
        </div>
      </section>

      {/* Posts Grid */}
      <section className="py-12 md:py-16">
        <div className="container-responsive">
          {isLoading ? (
            <div className="flex items-center justify-center py-12">
              <Loader2 className="w-8 h-8 text-primary animate-spin" />
            </div>
          ) : !posts || posts.length === 0 ? (
            <div className="text-center py-12">
              <p className="text-muted-foreground text-lg">
                {searching ? 'No posts found matching your search.' : 'No posts yet.'}
              </p>
            </div>
          ) : (
            <>
              <div className="grid gap-6 grid-cols-1 md:grid-cols-2 lg:grid-cols-3 mb-12">
                {posts.map((post) => (
                  <Link key={post.id} href={`/blog/${post.slug}`}>
                    <a className="card-hover group h-full flex flex-col">
                      {post.featuredImage && (
                        <div className="mb-4 overflow-hidden rounded h-40 bg-muted">
                          <img
                            src={post.featuredImage}
                            alt={post.title}
                            className="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                          />
                        </div>
                      )}

                      <div className="flex-1 flex flex-col">
                        <div className="mb-3 flex items-center gap-2 flex-wrap">
                          <span className="badge badge-secondary text-xs">
                            {new Date(post.publishedAt || post.createdAt).toLocaleDateString()}
                          </span>
                          <span className="badge badge-primary text-xs">
                            {post.readingTime} min read
                          </span>
                        </div>

                        <h3 className="text-lg font-bold mb-2 group-hover:text-secondary transition-colors line-clamp-2">
                          {post.title}
                        </h3>

                        <p className="text-sm text-muted-foreground mb-4 line-clamp-3 flex-1">
                          {post.excerpt}
                        </p>

                        <div className="flex items-center justify-between text-xs text-muted-foreground">
                          <span className="font-mono">{post.viewCount} views</span>
                          <span className="text-primary">→</span>
                        </div>
                      </div>
                    </a>
                  </Link>
                ))}
              </div>

              {/* Pagination */}
              {!searching && (
                <div className="flex items-center justify-center gap-4">
                  <button
                    onClick={() => setOffset(Math.max(0, offset - limit))}
                    disabled={offset === 0}
                    className="button button-outline disabled:opacity-50 disabled:cursor-not-allowed inline-flex items-center gap-2"
                  >
                    <ChevronLeft className="w-4 h-4" />
                    Previous
                  </button>

                  <span className="text-sm text-muted-foreground">
                    Page {Math.floor(offset / limit) + 1}
                  </span>

                  <button
                    onClick={() => setOffset(offset + limit)}
                    disabled={!posts || posts.length < limit}
                    className="button button-outline disabled:opacity-50 disabled:cursor-not-allowed inline-flex items-center gap-2"
                  >
                    Next
                    <ChevronRight className="w-4 h-4" />
                  </button>
                </div>
              )}
            </>
          )}
        </div>
      </section>
    </div>
  );
}
