import { useEffect, useState } from 'react';
import { useRoute, Link } from 'wouter';
import { trpc } from '@/lib/trpc';
import { Loader2, ChevronLeft, MessageSquare, Eye } from 'lucide-react';
import { Streamdown } from 'streamdown';

export default function BlogDetailPage() {
  const [route, params] = useRoute('/blog/:slug');
  const [commentName, setCommentName] = useState('');
  const [commentEmail, setCommentEmail] = useState('');
  const [commentContent, setCommentContent] = useState('');
  const [submittingComment, setSubmittingComment] = useState(false);

  const slug = params?.slug as string;
  const postQuery = trpc.blog.getBySlug.useQuery({ slug }, { enabled: !!slug });
  const commentsQuery = trpc.blog.getComments.useQuery(
    { postId: postQuery.data?.id || 0 },
    { enabled: !!postQuery.data?.id }
  );
  const addCommentMutation = trpc.blog.addComment.useMutation();

  const post = postQuery.data;
  const comments = commentsQuery.data || [];

  const handleCommentSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!post || !commentName || !commentEmail || !commentContent) return;

    setSubmittingComment(true);
    try {
      await addCommentMutation.mutateAsync({
        postId: post.id,
        authorName: commentName,
        authorEmail: commentEmail,
        content: commentContent,
      });

      setCommentName('');
      setCommentEmail('');
      setCommentContent('');

      // Refresh comments
      await commentsQuery.refetch();
    } catch (error) {
      console.error('Failed to submit comment:', error);
    } finally {
      setSubmittingComment(false);
    }
  };

  if (!route) return null;

  if (postQuery.isLoading) {
    return (
      <div className="min-h-screen bg-background text-foreground flex items-center justify-center">
        <Loader2 className="w-8 h-8 text-primary animate-spin" />
      </div>
    );
  }

  if (!post) {
    return (
      <div className="min-h-screen bg-background text-foreground">
        <div className="container-responsive py-20">
          <Link href="/blog">
            <a className="button button-outline inline-flex items-center gap-2 mb-8">
              <ChevronLeft className="w-4 h-4" />
              Back to Posts
            </a>
          </Link>
          <div className="text-center">
            <h1 className="text-3xl font-bold mb-4">Post Not Found</h1>
            <p className="text-muted-foreground">The post you're looking for doesn't exist.</p>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-background text-foreground">
      {/* Header */}
      <section className="border-b border-border py-8">
        <div className="container-responsive">
          <Link href="/blog">
            <a className="button button-outline inline-flex items-center gap-2 mb-6">
              <ChevronLeft className="w-4 h-4" />
              Back to Posts
            </a>
          </Link>
        </div>
      </section>

      {/* Post Content */}
      <article className="py-12 md:py-16">
        <div className="container-responsive max-w-3xl">
          {/* Featured Image */}
          {post.featuredImage && (
            <div className="mb-8 overflow-hidden rounded border border-border">
              <img
                src={post.featuredImage}
                alt={post.title}
                className="w-full h-96 object-cover"
              />
            </div>
          )}

          {/* Title */}
          <h1 className="text-4xl md:text-5xl font-bold mb-6 neon-glow">
            {post.title}
          </h1>

          {/* Metadata */}
          <div className="flex flex-wrap items-center gap-4 mb-8 pb-8 border-b border-border text-sm text-muted-foreground">
            <div className="flex items-center gap-2">
              <span className="font-mono text-primary">$</span>
              <span>{new Date(post.publishedAt || post.createdAt).toLocaleDateString()}</span>
            </div>
            <span>•</span>
            <div className="flex items-center gap-2">
              <span>{post.readingTime} min read</span>
            </div>
            <span>•</span>
            <div className="flex items-center gap-2">
              <Eye className="w-4 h-4" />
              <span>{post.viewCount} views</span>
            </div>
          </div>

          {/* Tags */}
          {post.tags && post.tags.length > 0 && (
            <div className="mb-8 flex flex-wrap gap-2">
              {post.tags.map((tag) => (
                <Link key={tag.id} href={`/blog/tag/${tag.slug}`}>
                  <a className="badge badge-accent hover:bg-accent/30 transition-colors">
                    #{tag.name}
                  </a>
                </Link>
              ))}
            </div>
          )}

          {/* Content */}
          <div className="prose prose-invert max-w-none mb-12">
            <Streamdown>{post.content}</Streamdown>
          </div>

          {/* Divider */}
          <div className="my-12 border-t border-border" />

          {/* Comments Section */}
          <section className="mt-12">
            <h2 className="text-2xl font-bold mb-8 flex items-center gap-2">
              <MessageSquare className="w-6 h-6 text-secondary" />
              Comments ({comments.length})
            </h2>

            {/* Comments List */}
            {comments.length > 0 && (
              <div className="mb-12 space-y-6">
                {comments.map((comment) => (
                  <div key={comment.id} className="card">
                    <div className="flex items-start justify-between mb-3">
                      <div>
                        <p className="font-bold text-foreground">{comment.authorName}</p>
                        <p className="text-xs text-muted-foreground">
                          {new Date(comment.createdAt).toLocaleDateString()}
                        </p>
                      </div>
                    </div>
                    <p className="text-sm text-foreground">{comment.content}</p>
                  </div>
                ))}
              </div>
            )}

            {/* Comment Form */}
            <div className="card border-2 border-primary/30">
              <h3 className="text-xl font-bold mb-6">Leave a Comment</h3>

              <form onSubmit={handleCommentSubmit} className="space-y-4">
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label className="block text-sm font-medium mb-2">Name</label>
                    <input
                      type="text"
                      value={commentName}
                      onChange={(e) => setCommentName(e.target.value)}
                      placeholder="Your name"
                      className="input"
                      required
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium mb-2">Email</label>
                    <input
                      type="email"
                      value={commentEmail}
                      onChange={(e) => setCommentEmail(e.target.value)}
                      placeholder="your@email.com"
                      className="input"
                      required
                    />
                  </div>
                </div>

                <div>
                  <label className="block text-sm font-medium mb-2">Comment</label>
                  <textarea
                    value={commentContent}
                    onChange={(e) => setCommentContent(e.target.value)}
                    placeholder="Share your thoughts..."
                    className="textarea min-h-32"
                    required
                  />
                </div>

                <button
                  type="submit"
                  disabled={submittingComment}
                  className="button button-primary w-full disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  {submittingComment ? (
                    <>
                      <Loader2 className="w-4 h-4 animate-spin mr-2" />
                      Submitting...
                    </>
                  ) : (
                    'Submit Comment'
                  )}
                </button>
              </form>
            </div>
          </section>
        </div>
      </article>

      {/* Related Posts */}
      <section className="py-12 md:py-16 border-t border-border bg-card/50">
        <div className="container-responsive">
          <h2 className="section-header">More Posts</h2>

          <div className="grid gap-6 grid-cols-1 md:grid-cols-3">
            {/* This could be populated with related posts */}
            <div className="card text-center py-8">
              <p className="text-muted-foreground">More posts coming soon...</p>
            </div>
          </div>
        </div>
      </section>
    </div>
  );
}
